{
  "name": "faf-wasm-core",
  "version": "1.2.2",
  "description": "The kernel router for FAF WASM engines. Rust + Zig (Cascade) both live. One interface, any kernel, same score.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "project.faf"
  ],
  "scripts": {
    "test": "bun test",
    "build": "tsc -p tsconfig.json && rm -rf dist/wasm && cp -R wasm dist/wasm",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "faf",
    "wasm",
    "ai-context",
    "scoring",
    "kernel"
  ],
  "author": "wolfejam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wolfe-Jam/faf-wasm-core"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
